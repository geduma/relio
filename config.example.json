{
  "auth": {
    "provider": "none"
  },
  "geduma": {
    "apiUrl": "geduma-api-url",
    "appId": "app_replace_with_your_app_id"
  },
  "security": {
    "encryptionKey": "replace-with-a-random-64-char-hex-string"
  },
  "db": {
    "path": "./db/db.sqlite"
  },
  "cache": {
    "ttlSeconds": 2592000
  },
  "server": {
    "port": 3000,
    "host": "0.0.0.0",
    "baseUrl": "http://localhost:3000",
    "nodeEnv": "development"
  },
  "cookie": {
    "secure": false,
    "sameSite": "strict",
    "httpOnly": true
  },
  "relay": {
    "exposeProvider": false
  }
}
