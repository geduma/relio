{
  "name": "relio",
  "version": "1.3.0",
  "description": "LLM Relay — intelligent proxy with failover, caching, and audit",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend",
    "build": "cd frontend && npm run build",
    "dev": "npm run build && node --watch src/index.js",
    "prestart": "node scripts/prestart.js",
    "start": "node src/index.js",
    "start:prod": "NODE_ENV=production node src/index.js",
    "lint": "eslint src tests scripts frontend/src eslint.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "express": "^4.19.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.8.0",
    "vitest": "^1.6.0"
  }
}
