{
  "name": "relio",
  "version": "1.0.0",
  "description": "LLM Relay — intelligent proxy with failover, caching, and audit",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "cd frontend && npm run build",
    "dev": "npm run build && node --watch src/index.js",
    "start": "node src/index.js",
    "start:prod": "NODE_ENV=production node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  }
}
