# Auth provider: geduma (default) | none
# To implement a custom provider, create src/auth/yourprovider.js
# and set AUTH_PROVIDER=yourprovider
AUTH_PROVIDER=geduma

# Geduma API Integration (only when AUTH_PROVIDER=geduma)
GEDUMA_API_URL=https://api.geduma.com
GEDUMA_API_TOKEN=your_geduma_api_token_here
# Base URL for OAuth redirect callbacks (must match registered redirect URI)
APP_BASE_URL=http://localhost:3000

# SQLite Database
DB_PATH=./db/db.sqlite

# Cache TTL (seconds, default 30 days)
CACHE_TTL_SECONDS=2592000

# Node Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Cookies
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_HTTP_ONLY=true
