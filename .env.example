# Geduma API Integration
GEDUMA_API_URL=https://geduma-api.com
GEDUMA_API_TOKEN=your_geduma_api_token_here
# Base URL for OAuth redirect callbacks (must match registered redirect URI)
APP_BASE_URL=http://localhost:3000

# SQLite Database
DB_PATH=./db/db.sqlite

# Cache TTL (seconds, default 30 days)
CACHE_TTL_SECONDS=2592000

# Node Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Cookies
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_HTTP_ONLY=true
